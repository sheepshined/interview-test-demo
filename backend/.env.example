# 复制此文件为 .env 并填入你的 API Key

# LLM API Key (推荐: 统一用此变量; 向后兼容下方 DEEPSEEK_API_KEY)
LLM_API_KEY=your_api_key_here

# DeepSeek (向后兼容: 若未设 LLM_API_KEY 则读此项)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# LLM 服务地址与模型 (默认 DeepSeek; 改智谱请设 LLM_BASE_URL=https://open.bigmodel.cn + LLM_MODEL=glm-4.5-air)
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 模型分层 (阶段3): fast=出题/评分(求速度), strong=总结报告(求质量, 可配 deepseek-reasoner)
LLM_MODEL_FAST=deepseek-chat
LLM_MODEL_STRONG=deepseek-chat

# 本地 BGE 嵌入模型路径 (留空则使用 Hub 自动下载 BAAI/bge-base-zh-v1.5)
# LOCAL_BGE_MODEL_PATH=D:/BGE_BASE_ZN_1.5/models--BAAI--bge-base-zh-v1.5/snapshots/f03589ceff5aac7111bd60cfc7d497ca17ecac65

# 在线 Embedding 回退 (true 时优先智谱 embedding-2, 免本地模型加载)
EMBEDDING_ONLINE=false

# CORS 允许的前端来源 (逗号分隔)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
